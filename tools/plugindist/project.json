{
  "name": "plugindist",
  "targets": {
    "catalog": {
      "executor": "nx:run-commands",
      "options": { "command": "go run ./cmd/plugindist", "cwd": "{projectRoot}" },
      "cache": false
    },
    "dist": {
      "executor": "nx:run-commands",
      "options": { "command": "go run ./cmd/plugindist -out dist", "cwd": "{projectRoot}" },
      "cache": false,
      "outputs": ["{projectRoot}/dist"]
    }
  }
}
