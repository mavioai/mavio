// mavio.dev's Worker (docs/mavio-dev.md §6). BETTER_AUTH_SECRET,
// CLOUDFLARE_ZONE_ID, CLOUDFLARE_API_TOKEN, GOOGLE_CA_PROJECT,
// GOOGLE_CA_CREDENTIALS and RELAY_TICKET_SECRET are secrets set with `wrangler secret put`;
// .dev.vars holds development's.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mavio-website",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "mavio.dev", "custom_domain": true }],
  "vars": { "BASE_URL": "https://mavio.dev", "APP_URL": "https://app.mavio.dev", "ACME_DOMAIN": "acme.mavio.dev" },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "mavio-website",
      "localConnectionString": "postgres://mavio:mavio@localhost:5432/mavio"
    }
  ],
  "durable_objects": { "bindings": [{ "name": "NOTICES", "class_name": "NoticeHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NoticeHub"] }],
  "observability": { "enabled": true }
}
