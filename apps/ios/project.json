{
  "name": "ios",
  "tags": [
    "platform:apple"
  ],
  "implicitDependencies": [
    "apple"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "xcodebuild -project Mavio.xcodeproj -scheme Mavio -destination 'generic/platform=iOS Simulator' -derivedDataPath ../../dist/xcode/ios ARCHS=arm64 CODE_SIGN_IDENTITY=- CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM= -quiet build",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        {
          "projects": [
            "apple"
          ],
          "target": "core"
        },
        {
          "projects": [
            "apple"
          ],
          "target": "ass"
        }
      ],
      "inputs": [
        "swift",
        "^swift",
        "{projectRoot}/Mavio.xcodeproj/**/*",
        {
          "dependentTasksOutputFiles": "**/*",
          "transitive": true
        },
        "{workspaceRoot}/libs/apple/scripts/version.sh",
        {
          "env": "MAVIO_VERSION"
        }
      ],
      "cache": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "swift format lint --strict --recursive Mavio",
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "swift",
        "{workspaceRoot}/.swift-format"
      ],
      "cache": true
    },
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 ../../libs/apple/scripts/gen-project.py ios",
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "{workspaceRoot}/libs/apple/scripts/gen-project.py"
      ],
      "outputs": [
        "{projectRoot}/Mavio.xcodeproj"
      ],
      "cache": true
    }
  }
}
