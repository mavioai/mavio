<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Servers on the local network, and finding them there. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Servers on the local network serve their media over plain HTTP. -->
    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:name=".MavioApplication"
        android:label="Mavio"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Mavio">
        <!-- Compose follows rotation itself, so the player and the screens
             keep their state as the player turns to landscape and goes
             into picture in picture. -->
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.Mavio.Launch"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The launcher's shortcut that starts the assistant listening. -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <!-- The system's voice search, handed to the assistant, and the
                 shortcut and the Quick Settings tile asking it to listen. -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <action android:name="com.google.android.gms.actions.SEARCH_ACTION" />
                <action android:name="dev.mavio.action.TALK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- mavio.dev sending the browser back from a sign-in, where the
                 browser opened a Custom Tab rather than an Auth Tab. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dev.mavio.app" />
            </intent-filter>
        </activity>
        <!-- The Quick Settings tile that starts the assistant listening. -->
        <service
            android:name=".TalkTile"
            android:exported="true"
            android:icon="@drawable/ic_microphone"
            android:label="@string/assistant_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
