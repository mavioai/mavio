{
  "name": "android",
  "tags": [
    "platform:android"
  ],
  "implicitDependencies": [
    "android-lib",
    "proto"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "gradle --console=plain assembleDebug",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        {
          "projects": [
            "android-lib"
          ],
          "target": "core"
        },
        {
          "projects": [
            "android-lib"
          ],
          "target": "mpv"
        },
        {
          "projects": [
            "android-lib"
          ],
          "target": "ffmpeg"
        }
      ],
      "inputs": [
        "gradle",
        "^gradle",
        "{workspaceRoot}/libs/proto/mavio/**/*.proto",
        {
          "dependentTasksOutputFiles": "**/*",
          "transitive": true
        },
        {
          "env": "MAVIO_VERSION"
        }
      ],
      "cache": true,
      "parallelism": false
    },
    "release": {
      "executor": "nx:run-commands",
      "options": {
        "command": "gradle --console=plain assembleRelease",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        {
          "projects": [
            "android-lib"
          ],
          "target": "core"
        },
        {
          "projects": [
            "android-lib"
          ],
          "target": "mpv"
        },
        {
          "projects": [
            "android-lib"
          ],
          "target": "ffmpeg"
        }
      ],
      "inputs": [
        "gradle",
        "^gradle",
        "{workspaceRoot}/libs/proto/mavio/**/*.proto",
        {
          "dependentTasksOutputFiles": "**/*",
          "transitive": true
        },
        {
          "env": "MAVIO_VERSION"
        }
      ],
      "cache": true,
      "parallelism": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "gradle --console=plain lintDebug",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        {
          "projects": [
            "android-lib"
          ],
          "target": "core"
        },
        {
          "projects": [
            "android-lib"
          ],
          "target": "mpv"
        },
        {
          "projects": [
            "android-lib"
          ],
          "target": "ffmpeg"
        }
      ],
      "inputs": [
        "gradle",
        "^gradle",
        "{workspaceRoot}/libs/proto/mavio/**/*.proto",
        {
          "dependentTasksOutputFiles": "**/*",
          "transitive": true
        }
      ],
      "cache": true,
      "parallelism": false
    }
  }
}
