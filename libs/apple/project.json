{
  "name": "apple",
  "tags": [
    "platform:apple"
  ],
  "implicitDependencies": [
    "client-rust",
    "design"
  ],
  "targets": {
    "core": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sh scripts/build-core.sh",
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "{projectRoot}/scripts/build-core.sh",
        "^rust",
        {
          "env": "MAVIO_CORE_PROFILE"
        },
        {
          "env": "MAVIO_MACOS_ARCHS"
        }
      ],
      "outputs": [
        "{projectRoot}/build/MavioCoreFFI.xcframework",
        "{projectRoot}/build/MavioCore"
      ],
      "cache": true
    },
    "ass": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sh tools/deps/fetch.sh libass",
        "cwd": "."
      },
      "inputs": [
        "{workspaceRoot}/tools/deps/fetch.sh",
        "{workspaceRoot}/tools/deps/deps.txt"
      ],
      "outputs": [
        "{projectRoot}/build/Libass.xcframework",
        "{projectRoot}/build/.libass.stamp"
      ],
      "cache": true
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "swift build",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "core",
        "ass"
      ],
      "inputs": [
        "swift",
        "^swift",
        {
          "dependentTasksOutputFiles": "**/*"
        }
      ],
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "swift test",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "core",
        "ass"
      ],
      "inputs": [
        "swift",
        "^swift",
        {
          "dependentTasksOutputFiles": "**/*"
        }
      ],
      "cache": true
    },
    "snapshot": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sh scripts/snapshot.sh",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "core",
        "ass"
      ],
      "cache": false
    },
    "snapshot-record": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sh scripts/snapshot.sh --record",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "core",
        "ass"
      ],
      "cache": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "swift format lint --strict --recursive Package.swift Sources Tests ../design/Package.swift",
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "swift",
        "{workspaceRoot}/.swift-format",
        "{workspaceRoot}/libs/design/Package.swift"
      ],
      "cache": true
    }
  }
}
