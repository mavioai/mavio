<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The core talks to servers over its own HTTP stack. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Self-hosted servers are mostly on the local network, which Android 17 guards. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- The assistant's voice sessions; asked for as the user first talks. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Televisions without a microphone keep the app. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
