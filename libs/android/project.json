{
  "name": "android-lib",
  "tags": [
    "platform:android"
  ],
  "implicitDependencies": [
    "client-rust",
    "design"
  ],
  "targets": {
    "core": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sh scripts/build-core.sh",
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "{projectRoot}/scripts/build-core.sh",
        "^rust",
        {
          "env": "MAVIO_CORE_PROFILE"
        }
      ],
      "outputs": [
        "{projectRoot}/core/build/rust"
      ],
      "cache": true
    },
    "mpv": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sh tools/deps/fetch.sh mpv",
        "cwd": "."
      },
      "inputs": [
        "{workspaceRoot}/tools/deps/fetch.sh",
        "{workspaceRoot}/tools/deps/deps.txt"
      ],
      "outputs": [
        "{projectRoot}/player/build/mpv",
        "{projectRoot}/player/build/.mpv.stamp"
      ],
      "cache": true
    },
    "ffmpeg": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sh tools/deps/fetch.sh media3-ffmpeg",
        "cwd": "."
      },
      "inputs": [
        "{workspaceRoot}/tools/deps/fetch.sh",
        "{workspaceRoot}/tools/deps/deps.txt"
      ],
      "outputs": [
        "{projectRoot}/player/build/ffmpeg",
        "{projectRoot}/player/build/.media3-ffmpeg.stamp"
      ],
      "cache": true
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "gradle --console=plain assembleDebug",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "core",
        "mpv",
        "ffmpeg"
      ],
      "inputs": [
        "gradle",
        "^gradle",
        {
          "dependentTasksOutputFiles": "**/*"
        }
      ],
      "cache": true,
      "parallelism": false
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "gradle --console=plain testDebugUnitTest",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "core",
        "mpv",
        "ffmpeg"
      ],
      "inputs": [
        "gradle",
        "^gradle",
        {
          "dependentTasksOutputFiles": "**/*"
        }
      ],
      "cache": true,
      "parallelism": false
    },
    "snapshot": {
      "executor": "nx:run-commands",
      "options": {
        "command": "gradle --console=plain verifyRoborazziDebug",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "core",
        "mpv",
        "ffmpeg"
      ],
      "cache": false,
      "parallelism": false
    },
    "snapshot-record": {
      "executor": "nx:run-commands",
      "options": {
        "command": "gradle --console=plain recordRoborazziDebug",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "core",
        "mpv",
        "ffmpeg"
      ],
      "cache": false,
      "parallelism": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "gradle --console=plain lintDebug",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "core",
        "mpv",
        "ffmpeg"
      ],
      "inputs": [
        "gradle",
        "^gradle",
        {
          "dependentTasksOutputFiles": "**/*"
        }
      ],
      "cache": true,
      "parallelism": false
    }
  }
}
