    "auth.quickConnectCode": {
      "comment": "Instruction of Quick Connect; code is six digits.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter %@ on a device that is signed in"
