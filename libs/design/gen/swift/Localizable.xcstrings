{
  "sourceLanguage": "en",
  "strings": {
    "nav.home": {
      "comment": "Top-level destination: continue watching, next up and the latest items.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首页"
          }
        }
      }
    },
    "nav.libraries": {
      "comment": "Top-level destination listing the media libraries.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Libraries"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "媒体库"
          }
        }
      }
    },
    "nav.search": {
      "comment": "Top-level destination searching every library.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索"
          }
        }
      }
    },
    "nav.downloads": {
      "comment": "Top-level destination of the items downloaded for offline playback.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载"
          }
        }
      }
    },
    "nav.profile": {
      "comment": "Top-level destination of the signed-in user, with settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "个人资料"
          }
        }
      }
    },
    "nav.settings": {
      "comment": "Screen of the app's and the user's settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置"
          }
        }
      }
    },
    "home.continueWatching": {
      "comment": "Shelf of items whose playback was left unfinished.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue Watching"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续观看"
          }
        }
      }
    },
    "home.nextUp": {
      "comment": "Shelf of the next episodes of the series being watched.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next Up"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一集"
          }
        }
      }
    },
    "home.latest": {
      "comment": "Shelf of the items added last to a library; library is its name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Latest in %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@最新内容"
          }
        }
      }
    },
    "library.sort": {
      "comment": "Button opening the sort options of a library.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sort"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排序"
          }
        }
      }
    },
    "library.filter": {
      "comment": "Button opening the filters of a library.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "筛选"
          }
        }
      }
    },
    "library.itemCount": {
      "comment": "Number of items in a library or list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld item"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld items"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld 个项目"
                }
              }
            }
          }
        }
      }
    },
    "item.play": {
      "comment": "Starts playback of an item from the beginning.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放"
          }
        }
      }
    },
    "item.resume": {
      "comment": "Resumes playback of an item where it was left.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续播放"
          }
        }
      }
    },
    "item.favorite": {
      "comment": "Toggles whether the item is a favorite.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorite"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏"
          }
        }
