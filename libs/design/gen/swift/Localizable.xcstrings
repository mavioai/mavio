      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld episode"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld episodes"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld 集"
                }
              }
            }
          }
        }
      }
    },
    "item.episodeNumber": {
      "comment": "Season and episode numbers of an episode.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Season %1$@, Episode %2$@"
