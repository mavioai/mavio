    "item.markUnplayed": {
      "comment": "Marks an item as not watched.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark as Unplayed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标为未看"
          }
