    "state.empty": {
      "comment": "Title of an empty list or library.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing here yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里还没有内容"
          }
        }
      }
    },
    "state.error": {
      "comment": "Title of a screen that failed to load.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出了点问题"
          }
        }
      }
    },
    "state.offline": {
      "comment": "Title shown when the server cannot be reached; downloaded items stay available.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're offline"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已离线"
          }
        }
      }
    },
    "action.retry": {
      "comment": "Retries a failed action.",
