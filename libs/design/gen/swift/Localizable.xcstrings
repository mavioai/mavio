      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resize Sidebar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整侧边栏宽度"
