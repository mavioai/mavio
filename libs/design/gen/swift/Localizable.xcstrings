{
  "sourceLanguage": "en",
  "strings": {
    "nav.home": {
      "comment": "Top-level destination: continue watching, next up and the latest items.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首页"
          }
        }
      }
    },
    "nav.libraries": {
      "comment": "Top-level destination listing the media libraries.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Libraries"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "媒体库"
          }
        }
      }
    },
    "nav.search": {
      "comment": "Top-level destination searching every library.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索"
          }
        }
      }
    },
    "nav.discover": {
      "comment": "Top-level destination of titles to discover and request, which the user's servers may not have.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discover"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现"
          }
        }
      }
    },
    "nav.downloads": {
      "comment": "Top-level destination of the items downloaded for offline playback.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载"
          }
        }
      }
    },
    "nav.profile": {
      "comment": "Top-level destination of the signed-in user, with settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "个人资料"
          }
        }
      }
    },
    "nav.settings": {
      "comment": "Screen of the app's and the user's settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置"
          }
        }
      }
    },
    "nav.collapseSidebar": {
      "comment": "Button that collapses the sidebar to a rail of icons.",
