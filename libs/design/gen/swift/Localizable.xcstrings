{
  "sourceLanguage": "en",
  "strings": {
    "nav.home": {
      "comment": "Top-level destination: continue watching, next up and the latest items.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首页"
          }
        }
      }
    },
    "nav.libraries": {
      "comment": "Top-level destination listing the media libraries.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Libraries"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "媒体库"
          }
        }
      }
    },
    "nav.search": {
      "comment": "Top-level destination searching every library.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索"
          }
        }
      }
    },
    "nav.discover": {
      "comment": "Top-level destination of titles to discover and request, which the user's servers may not have.",
