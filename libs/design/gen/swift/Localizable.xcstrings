      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, User Menu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，用户菜单"
          }
        }
