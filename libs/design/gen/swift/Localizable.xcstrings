    "auth.quickConnect": {
      "comment": "Signs in by approving a code on a device already signed in.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Quick Connect"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Quick Connect"
          }
        }
      }
