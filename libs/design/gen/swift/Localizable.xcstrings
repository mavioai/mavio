      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discover"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现"
          }
        }
      }
    },
    "nav.downloads": {
      "comment": "Top-level destination of the items downloaded for offline playback.",
