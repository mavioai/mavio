    "item.seasonCount": {
      "comment": "Number of seasons of a series.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld season"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld seasons"
                }
              }
