{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "neverConnectToCloud": true,
  "plugins": [
    "./tools/nx-go",
    "./tools/nx-cargo"
  ],
  "namedInputs": {
    "go": [
      "{projectRoot}/**/*.go",
      "{projectRoot}/go.mod",
      "{projectRoot}/go.sum",
      "{workspaceRoot}/go.work",
      {
        "env": "GOOS"
      },
      {
        "env": "GOARCH"
      },
      {
        "runtime": "go version"
      }
    ],
    "goTestdata": [
      "{projectRoot}/**/testdata/**/*"
    ],
    "goLintConfig": [
      "{workspaceRoot}/.golangci.yml"
    ],
    "rust": [
      "{projectRoot}/**/*.rs",
      "{projectRoot}/**/Cargo.toml",
      "{projectRoot}/Cargo.lock",
      "{projectRoot}/rust-toolchain.toml"
    ],
    "swift": [
      "{projectRoot}/**/*.swift",
      "{projectRoot}/**/*.xcassets/**/*",
      "{projectRoot}/**/*.xcstrings",
      "{projectRoot}/Package.resolved"
    ],
    "rustGen": [
      "{projectRoot}/gen/rust/**/*"
    ]
  }
}
