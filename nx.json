{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "neverConnectToCloud": true,
  "plugins": ["./tools/nx-go"],
  "namedInputs": {
    "go": [
      "{projectRoot}/**/*.go",
      "{projectRoot}/go.mod",
      "{projectRoot}/go.sum",
      "{workspaceRoot}/go.work",
      { "env": "GOOS" },
      { "env": "GOARCH" },
      { "runtime": "go version" }
    ],
    "goTestdata": ["{projectRoot}/**/testdata/**/*"],
    "goLintConfig": ["{workspaceRoot}/.golangci.yml"]
  }
}
