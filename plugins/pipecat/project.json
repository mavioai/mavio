{
  "name": "pipecat",
  "targets": {
    "build": {
      "command": "go run ./cmd/plugindist -python ../../plugins/pipecat",
      "options": { "cwd": "{workspaceRoot}/tools/plugindist" },
      "inputs": [
        "{projectRoot}/**/*",
        "!{projectRoot}/dist/**/*",
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/uv.lock",
        "{workspaceRoot}/.python-version",
        "{workspaceRoot}/libs/plugin/python/**/*",
        "{workspaceRoot}/libs/proto/gen/python/**/*",
        "{workspaceRoot}/tools/plugindist/**/*.go"
      ],
      "outputs": ["{projectRoot}/dist/plugin"]
    },
    "dev": {
      "command": "go run ./cmd/plugindist -dev ../../plugins/pipecat",
      "options": { "cwd": "{workspaceRoot}/tools/plugindist" },
      "cache": false,
      "continuous": true
    },
    "test": {
      "command": "uv run --package mavio-pipecat pytest plugins/pipecat",
      "options": { "cwd": "{workspaceRoot}" },
      "inputs": ["{projectRoot}/**/*", "{workspaceRoot}/pyproject.toml", "{workspaceRoot}/uv.lock"]
    },
    "lint": {
      "command": "uv run --package mavio-pipecat ruff check plugins/pipecat && uv run --package mavio-pipecat ruff format --check plugins/pipecat && uv run --package mavio-pipecat pyright plugins/pipecat",
      "options": { "cwd": "{workspaceRoot}" },
      "inputs": ["{projectRoot}/**/*", "{workspaceRoot}/pyproject.toml", "{workspaceRoot}/uv.lock"]
    },
    "tidy-check": {
      "command": "uv lock --check",
      "options": { "cwd": "{workspaceRoot}" },
      "inputs": ["{projectRoot}/pyproject.toml", "{workspaceRoot}/pyproject.toml", "{workspaceRoot}/uv.lock"]
    }
  }
}
