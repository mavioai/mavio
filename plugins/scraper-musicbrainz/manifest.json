{
  "id": "org.mavio.scraper-musicbrainz",
  "name": "MusicBrainz",
  "version": "0.1.0",
  "description": "Metadata for music artists, albums and tracks from MusicBrainz, with album covers from the Cover Art Archive.",
  "author": "Mavio",
  "homepage": "https://github.com/mavioai/mavio",
  "license": "GPL-3.0-only",
  "runtime": "RUNTIME_WASM",
  "capabilities": ["CAPABILITY_METADATA_PROVIDER"],
  "permissions": { "httpHosts": ["musicbrainz.org", "coverartarchive.org"] },
  "configSchema": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"object\",\"properties\":{\"base_url\":{\"type\":\"string\",\"format\":\"uri\",\"description\":\"MusicBrainz server, for mirrors\",\"default\":\"https://musicbrainz.org\"},\"requests_per_second\":{\"type\":\"number\",\"exclusiveMinimum\":0,\"description\":\"At most 1 on musicbrainz.org\",\"default\":1}},\"additionalProperties\":false}",
  "apiVersion": "1.0"
}
