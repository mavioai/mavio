# dependencies
node_modules/

# Nx
.nx/cache/
.nx/workspace-data/

# build outputs
dist/
/bin/
*.test
*.out
coverage/
# the web UI's build, embedded by the server; the directory itself is kept
!apps/server/internal/webui/dist/
apps/server/internal/webui/dist/*
!apps/server/internal/webui/dist/.gitkeep
# the assistant's grammar (libs/intent), built to WASM and embedded by the server
!apps/server/internal/assistant/intent/dist/
apps/server/internal/assistant/intent/dist/*
!apps/server/internal/assistant/intent/dist/.gitkeep

# the catalog of the first-party plugins built locally (see tools/plugindist)
/plugins/catalog.json

# generated test media (see tools/fixtures)
.fixtures/

# OS / editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Xcode
xcuserdata/

# Gradle
.gradle/
.kotlin/
local.properties

# Cloudflare Workers (apps/website)
.cloudflare/
.env.local
